#!/bin/bash
# $BROWSER wrapper — opens URLs in the correct tmux-chrome tab group
# Falls back to native Chrome if not in tmux or bridge is down

url="$1"
[[ -z "$url" ]] && exit 1

# If inside tmux, hand it to tmux-chrome. The bridge socket is required for the
# Chrome path but not for the TWeb one, which talks to a pane rather than to the
# extension — gating both on the socket sent every URL to the system browser
# whenever Chrome's bridge happened to be down.
#
# Which one is tmux-chrome's call (`tmux-chrome browser`: env, then the pane's,
# window's or global @browser option), so a Claude session that set its pane to
# tweb gets TWeb even while the Chrome bridge is down.
if [[ -n "$TMUX" ]]; then
  case "$(tmux-chrome browser 2>/dev/null)" in
    tweb | tweb-chrome) exec tmux-chrome open "$url" ;;
  esac
  [[ -S /tmp/tmux-chrome-bridge.sock ]] && exec tmux-chrome open "$url"
fi

# Fallback: open with system default
if [[ "$(uname)" == "Darwin" ]]; then
  exec open "$url"
else
  exec xdg-open "$url" 2>/dev/null
fi
